{
  "name": "bluemint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "check": "node --check server/index.js && node --check server/domain.js && node --check dist/backend.js",
    "build": "esbuild client/wallet.js --bundle --format=iife --global-name=BlueMintWallet --outfile=dist/wallet-runtime.js --minify"
  },
  "dependencies": {
    "@raydium-io/raydium-sdk-v2": "0.2.84-alpha",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
