PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
NODE_ENV=development
SOLANA_NETWORK=devnet
# Comma-separated wallet public keys allowed to record operator-reported events.
ADMIN_WALLETS=
# HTTPS RPC endpoint, optional. Never exposed to browser.
SOLANA_RPC_URL=
# Devnet only. Never set these to mainnet accounts.
RAYDIUM_PLATFORM_ID=
TREASURY_WALLET=

# A separately verified LaunchLab global config whose mintB is DEVNET_USDC_MINT.
RAYDIUM_GLOBAL_CONFIG_ID=
# Must match platformClaimFeeWallet on the platform account.
PLATFORM_FEE_WALLET=
DEVNET_USDC_MINT=
# Explicit target in six-decimal quote units; no SOL-default assumptions.
LAUNCH_RAISE_USDC_UNITS=
# Off until all configuration accounts have been independently reviewed.
ENABLE_DEVNET_MINTING=false
