PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
NODE_ENV=development
SOLANA_NETWORK=mainnet
# Comma-separated wallet public keys allowed to record operator-reported events.
ADMIN_WALLETS=
# HTTPS RPC endpoint, optional. Never exposed to browser.
SOLANA_RPC_URL=
# Public identifiers must all belong to the selected network.
PLATFORM_OWNER_WALLET=
RAYDIUM_PLATFORM_ID=
TREASURY_WALLET=

# A separately verified LaunchLab global config whose mintB is USDC_QUOTE_MINT.
RAYDIUM_GLOBAL_CONFIG_ID=
# Must match platformClaimFeeWallet on the platform account.
PLATFORM_FEE_WALLET=
USDC_QUOTE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Explicit target in six-decimal quote units; no SOL-default assumptions.
LAUNCH_RAISE_USDC_UNITS=
# Off until all configuration accounts have been independently reviewed.
ENABLE_TOKEN_MINTING=false

# Direct CPMM vault worker (simulation by default; separate fee-only signer)
ENABLE_KEEPER=false
KEEPER_KEYPAIR_PATH=

# New Memebase launches use Pump / COINx; legacy USDC configuration remains separate.
LAUNCH_MODE=pump
ENABLE_PUMP_MINTING=false
